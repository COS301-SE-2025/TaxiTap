{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "$EXPO_PUBLIC_CONVEX_URL",
        "EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY": "$EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY",
        "EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY": "$EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY",
        "EXPO_PUBLIC_IOS_BUNDLE_ID": "$EXPO_PUBLIC_IOS_BUNDLE_ID",
        "EXPO_PUBLIC_ANDROID_PACKAGE_NAME": "$EXPO_PUBLIC_ANDROID_PACKAGE_NAME",
        "CONVEX_DEPLOYMENT": "$CONVEX_DEPLOYMENT"
      }
    },
    "github-release": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "$EXPO_PUBLIC_CONVEX_URL",
        "EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY": "$EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY",
        "EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY": "$EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY",
        "EXPO_PUBLIC_IOS_BUNDLE_ID": "$EXPO_PUBLIC_IOS_BUNDLE_ID",
        "EXPO_PUBLIC_ANDROID_PACKAGE_NAME": "$EXPO_PUBLIC_ANDROID_PACKAGE_NAME",
        "CONVEX_DEPLOYMENT": "$CONVEX_DEPLOYMENT"
      }
    }
  },
  "submit": {
    "production": {}
  }
}